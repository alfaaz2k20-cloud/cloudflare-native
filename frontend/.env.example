# 1. Google Identity Services (GIS) / One-Tap Client ID (Recommended - Free, Sovereign, Carrier-Independent)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client ID
# Set Authorized Origins: https://alfaazcollective.org, https://www.alfaazcollective.org, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Firebase Web Client Configuration (Optional fallback for legacy phone SMS / social popups)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=alfaaz-collective.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=alfaaz-collective
VITE_FIREBASE_STORAGE_BUCKET=alfaaz-collective.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
