{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alfaaz-cloudflare-native",
	"main": "backend/src/index.ts",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alfaaz-d1",
			"database_id": "28a3ae5b-4d30-4e04-8c95-d764588e72f5",
			"migrations_dir": "database/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "a199adbc0269462b9227f908a80025e2"
		}
	],
	"vars": {
		"ENV": "production",
		"FRONTEND_URL": "https://alfaazcollective.org",
		"JWT_SECRET": "Alfaaz-Production-Master-Secret-Key-2026-!SecureJWT#",
		"EMAIL_PROVIDER": "dev"
	}
}