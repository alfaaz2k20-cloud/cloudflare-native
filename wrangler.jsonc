{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alfaaz-cloudflare-native",
	"main": "backend/src/index.ts",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "alfaazcollective.org",
			"custom_domain": true
		},
		{
			"pattern": "www.alfaazcollective.org",
			"custom_domain": true
		},
		{
			"pattern": "tch.alfaazcollective.org",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alfaaz-d1",
			"database_id": "28a3ae5b-4d30-4e04-8c95-d764588e72f5",
			"migrations_dir": "database/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "a199adbc0269462b9227f908a80025e2"
		}
	],
	"triggers": {
		"crons": [
			"0 10 * * SUN"
		]
	},
	"vars": {
		"ENV": "production",
		"FRONTEND_URL": "https://alfaazcollective.org",
		"EMAIL_PROVIDER": "webhook"
	}
}